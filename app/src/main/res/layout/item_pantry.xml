<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/textPantryItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pantry_item_name_preview"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textPantryItemQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pantry_item_quantity_preview"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/textPantryItemExpiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pantry_item_expiry_preview" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonDeletePantryItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/delete_ingredient"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/buttonEditPantryItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit_ingredient"
            android:textAllCaps="false" />
    </LinearLayout>

</LinearLayout>